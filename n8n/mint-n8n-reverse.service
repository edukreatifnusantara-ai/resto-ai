[Unit]
Description=PC Mint reverse tunnel for n8n webhook to Resto-AI VPS
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -i %h/.ssh/pc_rumah_ed25519 -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -N -T -R 127.0.0.1:25678:127.0.0.1:5678 edukreativ-vps@103.89.5.220
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
