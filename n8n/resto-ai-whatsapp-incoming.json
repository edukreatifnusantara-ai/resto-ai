      },
      "id": "resto-api-chat",
      "name": "Resto-AI API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst incoming = $('Normalize Incoming').first().json;\nconst recipient = String(incoming.chat_jid || incoming.sender || '');\n\nif (!response.reply && !response.image_path) {\n  return [{\n    json: {\n      to: recipient,\n      message: 'Maaf, Resto-AI belum dapat memproses pesan ini.',\n      image_path: '',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    to: recipient,\n    message: String(response.reply || ''),\n    image_path: response.image_path ? String(response.image_path) : '',\n  },\n}];"
      },
