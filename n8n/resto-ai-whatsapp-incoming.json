        "jsCode": "const payload = $json.body && typeof $json.body === 'object' ? $json.body : $json;\n\nreturn [{\n  json: {\n    sender: String(payload.sender || ''),\n    chat_jid: String(payload.chat_jid || payload.jid || payload.remote_jid || payload.sender || ''),\n    body: String(payload.body || ''),\n    message_id: payload.message_id ? String(payload.message_id) : null,\n  },\n}];"
