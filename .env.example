# Safe template only. Uncomment and fill chosen entries in the private .env.
# The project .env takes priority over the legacy .env.runtime in the API service.

# LLM provider (choose openai or gemini if both provider keys are present)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Resto-AI API and web authentication
# RESTO_API_TOKEN=
# RESTO_WEB_AUTH_ENABLED=true
# RESTO_WEB_PASSWORD=

# Meta WhatsApp Cloud API (keep dry-run enabled until live delivery is approved)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=
# WHATSAPP_DRY_RUN=true

# Midtrans (use sandbox credentials first; do not enable production by default)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
